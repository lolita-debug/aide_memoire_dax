{
  "name": "D2 sombre accessible (Okabe-Ito + Viridis) · CC BY 4.0",
  "dataColors": [
    "#56B4E9",
    "#E69F00",
    "#009E73",
    "#CC79A7",
    "#F0E442",
    "#D55E00",
    "#D4D4D4"
  ],
  "foreground": "#D4D4D4",
  "foregroundNeutralSecondary": "#9D9D9D",
  "foregroundNeutralTertiary": "#8C9AB0",
  "background": "#162A45",
  "backgroundLight": "#1B3150",
  "backgroundNeutral": "#2A3F5E",
  "tableAccent": "#6BAED6",
  "hyperlink": "#6BAED6",
  "visitedHyperlink": "#9ECAE1",
  "good": "#6BAED6",
  "neutral": "#9D9D9D",
  "bad": "#E69F00",
  "maximum": "#FDE725",
  "center": "#21918C",
  "minimum": "#3B528B",
  "textClasses": {
    "callout": {
      "fontFace": "Calibri",
      "fontSize": 22,
      "color": "#FFFFFF"
    },
    "title": {
      "fontFace": "Calibri",
      "fontSize": 14,
      "color": "#FFFFFF"
    },
    "header": {
      "fontFace": "Calibri",
      "fontSize": 12,
      "color": "#FFFFFF"
    },
    "label": {
      "fontFace": "Calibri",
      "fontSize": 11,
      "color": "#D4D4D4"
    },
    "largeTitle": {
      "fontFace": "Calibri",
      "fontSize": 20,
      "color": "#FFFFFF"
    },
    "smallLabel": {
      "fontFace": "Calibri",
      "fontSize": 9,
      "color": "#9D9D9D"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0F1E33"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#0A1628"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#162A45"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "color": {
              "solid": {
                "color": "#2A3F5E"
              }
            }
          }
        ],
        "title": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#9D9D9D"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "shapeCustomRectangle": [
          {
            "tileShape": "rectangleRounded",
            "rectangleRoundedCurve": 14
          }
        ],
        "fillCustom": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#1B3150"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "show": false
          }
        ],
        "accentBar": [
          {
            "show": false
          }
        ],
        "divider": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "paddingUniform": 12
          }
        ],
        "value": [
          {
            "fontFamily": "Calibri",
            "fontSize": 22,
            "bold": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "horizontalAlignment": "center"
          }
        ],
        "label": [
          {
            "fontFamily": "Calibri",
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#9D9D9D"
              }
            },
            "position": "belowValue",
            "horizontalAlignment": "center"
          }
        ],
        "referenceLabelValue": [
          {
            "valueFontFamily": "Calibri",
            "valueFontColor": {
              "solid": {
                "color": "#6BAED6"
              }
            }
          }
        ],
        "referenceLabelTitle": [
          {
            "titleFontFamily": "Calibri",
            "titleFontColor": {
              "solid": {
                "color": "#9D9D9D"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1B3150"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#162A45"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#1A3050"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#D4D4D4"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#D4D4D4"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "total": [
          {
            "backColor": {
              "solid": {
                "color": "#1B3150"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#2A3F5E"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#2A3F5E"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#2A3F5E"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "backColor": {
              "solid": {
                "color": "#1B3150"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#D4D4D4"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#162A45"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#1A3050"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#D4D4D4"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#D4D4D4"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "grid": [
          {
            "gridHorizontalColor": {
              "solid": {
                "color": "#2A3F5E"
              }
            },
            "gridVerticalColor": {
              "solid": {
                "color": "#2A3F5E"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#2A3F5E"
              }
            }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "fill": [
          {
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#1B3150"
              }
            },
            "transparency": 0
          }
        ],
        "text": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Calibri"
          }
        ],
        "outline": [
          {
            "show": false
          }
        ]
      }
    },
    "advancedSlicerVisual": {
      "*": {
        "fillCustom": [
          {
            "$id": "selection:selected",
            "show": true,
            "fillColor": {
              "solid": {
                "color": "#2171B5"
              }
            },
            "transparency": 0
          }
        ],
        "outline": [
          {
            "lineColor": {
              "solid": {
                "color": "#2A3F5E"
              }
            }
          }
        ],
        "value": [
          {
            "$id": "default",
            "fontColor": {
              "solid": {
                "color": "#000000"
              }
            }
          },
          {
            "$id": "selection:selected",
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ]
      }
    }
  }
}