	partition Produits = m
		mode: import
		queryGroup: Exemples
		source =
				// ============================================================
				// TABLE : Produits (DONNÉES FICTIVES — fiches exemples)
				// 14 produits de 5 marques imaginaires. Poids = fréquence de tirage
				// dans Commandes (Kalisto est volontairement rare : fiche COALESCE)
				// ============================================================
				let
				    Source = #table(
				        type table [ProduitKey = Int64.Type, Produit = text, Marque = text, Categorie = text, PrixUnitaire = number, Poids = Int64.Type],
				        {
				            { 1, "Novatek Phone 15 Pro",        "Novatek",     "Smartphones",  1199, 18},
				            { 2, "Novatek Phone 15",            "Novatek",     "Smartphones",   899, 22},
				            { 3, "Novatek Tab 11",              "Novatek",     "Tablettes",     649, 10},
				            { 4, "Novatek Montre S",            "Novatek",     "Accessoires",   349,  6},
				            { 5, "Lumeo R9 Ultra",            "Lumeo",     "Smartphones",  1099, 15},
				            { 6, "Lumeo R7",                  "Lumeo",     "Smartphones",   449, 25},
				            { 7, "Lumeo Tab S",               "Lumeo",     "Tablettes",     399,  8},
				            { 8, "Lumeo Écouteurs Buds",      "Lumeo",     "Audio",          99, 12},
				            { 9, "Ortiva Chargeur 65W",         "Ortiva",      "Accessoires",    49, 30},
				            {10, "Ortiva Batterie 20000",       "Ortiva",      "Accessoires",    39, 28},
				            {11, "Ortiva Câble USB-C 2 m",      "Ortiva",      "Accessoires",    19, 35},
				            {12, "Zentra Casque NC700",       "Zentra",    "Audio",         299,  9},
				            {13, "Zentra Écouteurs Pods",     "Zentra",    "Audio",         179, 14},
				            {14, "Kalisto Enceinte Hi-Fi",  "Kalisto", "Audio",        1490,  1}
				        }
				    )
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

