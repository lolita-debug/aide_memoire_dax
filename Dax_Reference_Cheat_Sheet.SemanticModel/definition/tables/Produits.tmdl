/// Données fictives : produits
table Produits
	lineageTag: 2421201d-0e68-1ee3-0da6-1ccb13505928

	column ProduitKey
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e67e6548-a797-e264-ad78-cdbca5f4f742
		summarizeBy: none
		sourceColumn: ProduitKey

		annotation SummarizationSetBy = Automatic

	column Produit
		dataType: string
		lineageTag: ffe8af60-3bee-fba8-3262-1a5ecbc53dd0
		summarizeBy: none
		sourceColumn: Produit

		annotation SummarizationSetBy = Automatic

	column Marque
		dataType: string
		lineageTag: 713eefc0-d291-3ab7-1158-ee03dd087ab9
		summarizeBy: none
		sourceColumn: Marque

		annotation SummarizationSetBy = Automatic

	column Categorie
		dataType: string
