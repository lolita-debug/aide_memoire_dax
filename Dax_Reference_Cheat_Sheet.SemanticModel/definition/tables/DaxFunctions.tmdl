	partition DaxFunctions-2806c0de-ed74-4b32-89f2-bdd8752d5706 = m
		mode: import
		queryGroup: Tables
		source =
				// ============================================================
				// TABLE FINALE : DaxFunctions
				// RÔLE : Orchestre le scraping — boucle sur les 15 catégories,
				//        récupère toutes les fonctions DAX et leurs détails
				//        depuis learn.microsoft.com/fr-fr
				// ============================================================
				let
				    // -- Étape 1 : Partir de la liste des catégories (hardcodée, stable)
				    #"Source catégories" = Table.SelectColumns(DaxFunctionTypes, {"DaxFunctionTypes", "DaxFunctionTypesLink"}),
				
				    // -- Étape 2 : Ajouter le chemin web de base sur chaque ligne
				    #"Ajout chemin web" = Table.AddColumn(#"Source catégories", "DaxFunctionWebPath", each ParamWebPath, type text),
				
				    // -- Étape 3 : Pour chaque catégorie, appeler GetDaxFunctions (nom + lien + description courte)
				    #"Appel GetDaxFunctions" = Table.AddColumn(
				        #"Ajout chemin web",
				        "ListeFonctions",
				        each GetDaxFunctions([DaxFunctionWebPath], [DaxFunctionTypesLink])
				    ),
				
				    // -- Étape 4 : Déplier la table des fonctions pour chaque catégorie
				    #"Dépliage fonctions" = Table.ExpandTableColumn(
				        #"Appel GetDaxFunctions",
				        "ListeFonctions",
				        {"NomFonctionDAX", "LienFonctionDAX", "DescriptionCourte"}
				    ),
				
				    // -- Étape 5 : Supprimer les lignes sans nom de fonction (sécurité)
				    #"Suppression lignes vides" = Table.SelectRows(
				        #"Dépliage fonctions",
				        each [NomFonctionDAX] <> null and [NomFonctionDAX] <> ""
				    ),
				
				    // -- Étape 6a : Mettre en mémoire la liste scrapée (sinon les pages catégories
				    //             seraient téléchargées deux fois : étapes 6b et 6c)
				    #"Fonctions en mémoire" = Table.Buffer(#"Suppression lignes vides"),
				
				    // -- Étape 6b : Mémoriser toutes les catégories de chaque fonction avant dédoublonnage
				    #"Catégories par fonction" = Record.FromTable(
				        Table.RenameColumns(
				            Table.Group(#"Fonctions en mémoire", {"NomFonctionDAX"},
				                {{"Categories", each Text.Combine(List.Distinct([DaxFunctionTypes]), " · "), type text}}),
				            {{"NomFonctionDAX", "Name"}, {"Categories", "Value"}}
				        )
				    ),
				
				    // -- Étape 6c : 1 ligne par fonction (NomFonctionDAX = côté 1 de la relation avec DATA_DAX)
				    //             Si une fonction apparaît dans 2 catégories, on garde la 1re (ordre des catégories)
				    #"Dédoublonnage fonctions" = Table.Distinct(#"Fonctions en mémoire", {"NomFonctionDAX"}),
				    #"Ajout toutes catégories" = Table.AddColumn(
				        #"Dédoublonnage fonctions",
				        "ToutesCategories",
				        each Record.FieldOrDefault(#"Catégories par fonction", [NomFonctionDAX], null),
				        type text
				    ),
				
				    // -- Étape 7 : URL complète de référence de chaque fonction
				    #"Ajout URL référence" = Table.AddColumn(
				        #"Ajout toutes catégories",
				        "URLReference",
				        each [DaxFunctionWebPath] & [LienFonctionDAX],
				        type text
				    ),
				
				    // -- Étape 8 : Pour chaque fonction, appeler GetDaxFunctionDetails
				    //             try ... otherwise null : pages inaccessibles (404, etc.)
				    //             ParamScraperDetails = false : pas d'appel (actualisation rapide)
				    #"Appel GetDaxFunctionDetails" = Table.AddColumn(
				        #"Ajout URL référence",
				        "Details",
				        each if ParamScraperDetails then (try GetDaxFunctionDetails([DaxFunctionWebPath], [LienFonctionDAX]) otherwise null) else null
				    ),
				
				    // -- Étape 9 : Déplier les détails de chaque fonction
				    #"Dépliage détails" = Table.ExpandTableColumn(
				        #"Appel GetDaxFunctionDetails",
				        "Details",
				        {"DescriptionFonction", "SyntaxeFonction", "ValeurRetour", "Remarques", "Exemples", "MethodeExtraction"}
				    ),
				
				    // -- Étape 10 : Typage final
				    #"Typage colonnes final" = Table.TransformColumnTypes(
				        #"Dépliage détails",
				        {
				            {"NomFonctionDAX",      type text},
				            {"LienFonctionDAX",     type text},
				            {"DescriptionCourte",   type text},
				            {"DescriptionFonction", type text},
				            {"SyntaxeFonction",     type text},
				            {"ValeurRetour",        type text},
				            {"Remarques",           type text},
				            {"Exemples",            type text},
				            {"ToutesCategories",    type text},
				            {"MethodeExtraction",   type text}
				        }
				    )
				in
				    #"Typage colonnes final"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

