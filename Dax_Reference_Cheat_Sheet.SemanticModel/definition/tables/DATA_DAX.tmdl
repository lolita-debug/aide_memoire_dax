	partition DATA_DAX = m
		mode: import
		queryGroup: Tables
		source =
				// ============================================================
				// TABLE : DATA_DAX
				// RÔLE  : Fiches DAX maison (classeur Excel COMMANDES_DAX)
				//         Chemin du fichier : paramètre ParamCheminExcel
				// ============================================================
				let
				    // FACULTATIF : sans classeur (chemin absent ou invalide), la table est vide et le rapport fonctionne
				    Vide = #table(type table [Source = text, #"Nature de la fonction" = text, #"Utilisation - Objet en sortie" = text, #"Fonction DAX" = text,
				        Type = text, Cal_Column = text, Cal_Table = text, Mesure = text, Cal_Visuel = text, Description = text, Exemple = text,
				        Remarque = text, Fonction = text], {}),
				    DATA_DAX_Table = try Excel.Workbook(File.Contents(ParamCheminExcel), null, true){[Item="DATA_DAX",Kind="Table"]}[Data] otherwise Vide,
				    #"Type modifié" = Table.TransformColumnTypes(DATA_DAX_Table, {{"Source", type text}, {"Nature de la fonction", type text}, {"Utilisation - Objet en sortie", type text}, {"Fonction DAX", type text}, {"Type", type text}, {"Cal_Column", type text}, {"Cal_Table", type text}, {"Mesure", type text}, {"Cal_Visuel", type text}, {"Description", type text}, {"Exemple", type text}, {"Remarque", type text}, {"Fonction", type text}}),
				
				    // -- Même normalisation que DaxFunctions[NomFonctionDAX] pour que la relation matche
				    #"Normalisation nom" = Table.TransformColumns(
				        #"Type modifié",
				        {{"Fonction DAX", each if _ <> null then Text.Upper(Text.Trim(Text.Clean(_))) else null, type text}}
				    ),
				
				    // -- Matrice d'usage : symbole → mot AVANT chargement. Le moteur du modèle compare le texte sans tenir
				    //    compte de la casse et confond ✔/❗/❌ : il ne garderait qu'un seul de ces symboles par colonne.
				    //    Power Query, lui, compare caractère par caractère (codes Unicode 10004 / 10071 / 10060).
				    SymboleEnMot = (s) => if s = null or Text.Trim(s) = "" then null else
				        let c = Character.ToNumber(Text.Start(Text.Trim(s), 1)) in
				        if c = 10004 then "OUI" else if c = 10071 then "PRECAUTION" else if c = 10060 then "NON" else null,
				    #"Matrice en mots" = Table.TransformColumns(
				        #"Normalisation nom",
				        {{"Cal_Column", SymboleEnMot, type text}, {"Cal_Table", SymboleEnMot, type text}, {"Mesure", SymboleEnMot, type text}, {"Cal_Visuel", SymboleEnMot, type text}}
				    )
				in
				    #"Matrice en mots"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

