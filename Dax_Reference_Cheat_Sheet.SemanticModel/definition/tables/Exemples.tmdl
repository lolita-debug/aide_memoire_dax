	/// Mesures affichées dans la fiche, séparées par « | », dans l'ordre d'affichage (noms exacts du modèle)
	column Mesures
		dataType: string
		lineageTag: ccc61e57-5c7f-583d-9159-8452171949fc
		summarizeBy: none
		sourceColumn: Mesures

