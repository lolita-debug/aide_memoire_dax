table TopFonctionsDAX
	lineageTag: ff4a84bc-7728-44d1-9010-aab74041ec0c

	column Rang
		dataType: int64
		formatString: 0
		lineageTag: 619e20fe-71e3-46bf-a5e4-3a363a52cd55
		summarizeBy: none
		sourceColumn: Rang

		annotation SummarizationSetBy = Automatic

	column NomFonctionDAX
		dataType: string
		lineageTag: e97cf8ea-6253-4c7c-8d50-39437cd02366
		summarizeBy: none
		sourceColumn: NomFonctionDAX

		annotation SummarizationSetBy = Automatic

	column Niveau
		dataType: string
		lineageTag: 72f77bc3-308f-4df0-86fe-1614af46ec96
		summarizeBy: none
		sourceColumn: Niveau
		sortByColumn: OrdreNiveau

		annotation SummarizationSetBy = Automatic

	column OrdreNiveau
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2037b37c-d7fe-4bd3-84d3-889d28564e44
		summarizeBy: none
		sourceColumn: OrdreNiveau

		annotation SummarizationSetBy = Automatic

	/// Carte HTML de la fonction (mesure _Top25_HTML)
	column CardHTML =
			-- Carte HTML d'une fonction du Top 25 (lue par la mesure _Top25_HTML)
			-- Description : courte (page catégorie) > détaillée (page fonction) > exemple Excel
			-- Les textes sont échappés : la syntaxe Microsoft contient <expression>, <filter>...
			VAR _nom = TopFonctionsDAX[NomFonctionDAX]
			VAR _descCourte = MAXX ( RELATEDTABLE ( DaxFunctions ), DaxFunctions[DescriptionCourte] )
			VAR _descLongue = MAXX ( RELATEDTABLE ( DaxFunctions ), DaxFunctions[DescriptionFonction] )
			VAR _syntaxeBrute = MAXX ( RELATEDTABLE ( DaxFunctions ), DaxFunctions[SyntaxeFonction] )
			VAR _exempleBrut = MAXX ( FILTER ( DATA_DAX, DATA_DAX[Fonction DAX] = _nom ), DATA_DAX[Exemple] )
			VAR _descBrute =
			    SWITCH (
			        TRUE (),
			        LEN ( _descCourte ) > 0, _descCourte,
			        LEN ( _descLongue ) > 0, _descLongue,
			        _exempleBrut
			    )
			VAR _descCoupee = IF ( LEN ( _descBrute ) > 80, LEFT ( _descBrute, 80 ) & "…", _descBrute )
			VAR _exCoupe = IF ( LEN ( _exempleBrut ) > 60, LEFT ( _exempleBrut, 60 ) & "…", _exempleBrut )
			VAR _desc = IF ( LEN ( _descCoupee ) > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _descCoupee, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "—" )
			VAR _syntaxe = IF ( LEN ( _syntaxeBrute ) > 0, SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _syntaxeBrute, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "—" )
			VAR _exemple = IF ( LEN ( _exCoupe ) > 0, "ex : " & SUBSTITUTE ( SUBSTITUTE ( SUBSTITUTE ( _exCoupe, "&", "&amp;" ), "<", "&lt;" ), ">", "&gt;" ), "" )
			VAR _classe = SWITCH ( TopFonctionsDAX[Niveau], "Essentiel", "e", "Courant", "c", "a" )
			RETURN
			    "<div class='card " & _classe & "'>"
			        & "<span class='rg'>#" & TopFonctionsDAX[Rang] & "</span>"
			        & "<span class='bd " & _classe & "'>" & TopFonctionsDAX[Niveau] & "</span>"
			        & "<div class='nm'>" & _nom & "</div>"
			        & "<div class='dc'>" & _desc & "</div>"
			        & "<div class='sx'>" & _syntaxe & "</div>"
			        & "<div class='ex'>" & _exemple & "</div>"
			        & "</div>"
		dataType: string
		isHidden
		lineageTag: 31d01371-bf10-43d3-962d-bc07564df30a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition TopFonctionsDAX = m
		mode: import
		queryGroup: Tables
		source =
				// ============================================================
				// TABLE : TopFonctionsDAX
				// RÔLE  : Classement des fonctions DAX indispensables
				//         Sources : SQLBI, Microsoft Docs, communauté Power BI
				//         À enrichir manuellement si besoin
				// NOTE  : la carte HTML (CardHTML) est une colonne calculée DAX
				// ============================================================
				let
				    #"Table Top Fonctions" = #table(
				        type table [Rang = Int64.Type, NomFonctionDAX = text, Niveau = text, OrdreNiveau = Int64.Type],
				        {
				            { 1, "CALCULATE",           "Essentiel", 1},
				            { 2, "SUM",                 "Essentiel", 1},
				            { 3, "SUMX",                "Essentiel", 1},
				            { 4, "FILTER",              "Essentiel", 1},
				            { 5, "IF",                  "Essentiel", 1},
				            { 6, "ALL",                 "Essentiel", 1},
				            { 7, "RELATED",             "Essentiel", 1},
				            { 8, "DIVIDE",              "Essentiel", 1},
				            { 9, "COUNTROWS",           "Essentiel", 1},
				            {10, "DISTINCTCOUNT",       "Essentiel", 1},
				            {11, "AVERAGE",             "Essentiel", 1},
				            {12, "MAX",                 "Essentiel", 1},
				            {13, "MIN",                 "Essentiel", 1},
				            {14, "SWITCH",              "Courant",   2},
				            {15, "SELECTEDVALUE",       "Courant",   2},
				            {16, "LOOKUPVALUE",         "Courant",   2},
				            {17, "TOTALYTD",            "Courant",   2},
				            {18, "SAMEPERIODLASTYEAR",  "Courant",   2},
				            {19, "DATEADD",             "Courant",   2},
				            {20, "USERELATIONSHIP",     "Courant",   2},
				            {21, "RANKX",               "Avancé",    3},
				            {22, "TOPN",                "Avancé",    3},
				            {23, "HASONEVALUE",         "Avancé",    3},
				            {24, "TREATAS",             "Avancé",    3},
				            {25, "CONCATENATEX",        "Avancé",    3}
				        }
				    )
				in
				    #"Table Top Fonctions"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

